{
  "name": "kitchtech/api",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\Shared\\": "src/Shared/",
      "App\\Flashcard\\": "src/Flashcard/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
